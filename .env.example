# Copy this file to .env and fill in ONE of the two admin/migration options below
# using the values shown by Supabase's Connect dialog for the BirdBrain DEVELOPMENT
# project. .env is gitignored. Never commit real passwords or connection details.

# OPTION A — easiest when your password is safe to use inside a URL.
BB_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require

# OPTION B — use these instead if you prefer separate fields or your password
# contains URL-special characters. If using Option B, delete/comment BB_DATABASE_URL.
# BB_DB_HOST=HOST
# BB_DB_PORT=5432
# BB_DB_NAME=postgres
# BB_DB_USER=USER
# BB_DB_PASSWORD=PASSWORD
# BB_DB_SSLMODE=require

# HOSTED SHINY — least-privilege reader credentials.
# Do not copy the postgres/admin password here. Generate these with:
#   python python/birdbrain_migrate/provision_shiny_reader.py --apply
# The R/Shiny app prefers these values while migration utilities continue using
# the admin BB_DB_* values above.
# BB_SHINY_DB_USER=birdbrain_shiny_reader.PROJECT_REF
# BB_SHINY_DB_PASSWORD=GENERATED_LOCALLY
