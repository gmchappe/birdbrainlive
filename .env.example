# Copy this file to .env and fill in ONE of the two options below using the
# values shown by Supabase's Connect dialog for the BirdBrain DEVELOPMENT project.
# .env is gitignored. Never commit the real password or connection details.

# OPTION A — easiest when your password is safe to use inside a URL.
BB_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require

# OPTION B — use these instead if you prefer separate fields or your password
# contains URL-special characters. If using Option B, delete/comment BB_DATABASE_URL.
# BB_DB_HOST=HOST
# BB_DB_PORT=5432
# BB_DB_NAME=postgres
# BB_DB_USER=USER
# BB_DB_PASSWORD=PASSWORD
# BB_DB_SSLMODE=require
